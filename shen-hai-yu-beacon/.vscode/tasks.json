{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Firmware",
            "type": "shell",
            "command": "make all",
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": ["relative", "${workspaceFolder}/firmware"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make clean",
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "group": "build"
        },
        {
            "label": "Flash",
            "type": "shell",
            "command": "make flash",
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "group": "build",
            "dependsOn": "Build Firmware"
        },
        {
            "label": "Get RT-Thread Nano",
            "type": "shell",
            "command": "git clone https://github.com/RT-Thread/rtthread-nano RTThread/nano",
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "group": "build"
        }
    ]
}
